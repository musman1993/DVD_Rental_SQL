flowchart TD

    classDef existing fill:#1f6f43,stroke:#0d3b23,color:#fff,stroke-width:2px
    classDef phase2 fill:#2563eb,stroke:#1e3a8a,color:#fff,stroke-width:2px
    classDef phase3 fill:#7c3aed,stroke:#4c1d95,color:#fff,stroke-width:2px
    classDef phase4 fill:#dc2626,stroke:#7f1d1d,color:#fff,stroke-width:2px
    classDef phase5 fill:#ea580c,stroke:#7c2d12,color:#fff,stroke-width:2px
    classDef phase6 fill:#0891b2,stroke:#164e63,color:#fff,stroke-width:2px

    subgraph SRC["📦 SOURCE"]
        A["Postgres 17\ndvdrental DB\n(Docker + Colima)"]:::existing
    end

    subgraph P1["Phase 1 — Foundation Cleanup"]
        B1["Finish notebook\n(clean SQL practice)"]:::existing
        B2["Write README\n+ architecture docs"]:::existing
    end

    subgraph P4["Phase 4 — Security Fix"]
        D1["Parameterized queries\n(no f-string SQL)"]:::phase4
        D2["Env vars for creds\n(.env, no hardcoding)"]:::phase4
    end

    subgraph P2["Phase 2 — Transformation Layer"]
        C1["dbt project"]:::phase2
        C2["Staging models\n(stg_customer, stg_rental, stg_film)"]:::phase2
        C3["Star schema\nfact_rental + dim_customer\n+ dim_film + dim_date"]:::phase2
        C4["dbt tests + docs"]:::phase2
    end

    subgraph P3["Phase 3 — Orchestration"]
        E1["Dagster / Airflow DAG"]:::phase3
        E2["Extract → dbt run → dbt test\n→ refresh downstream"]:::phase3
        E3["Scheduled runs"]:::phase3
    end

    subgraph P5["Phase 5 — Warehouse + BI Swap"]
        F1["ClickHouse\n(reuse existing stack)"]:::phase5
        F2["Apache Superset\ndashboards"]:::phase5
    end

    subgraph P6["Phase 6 — ML Layer"]
        G1["Feature set from\nfact_rental / dim_customer"]:::phase6
        G2["scikit-learn model\n(churn or demand forecast)"]:::phase6
        G3["Model output surfaced\nin Superset / notebook"]:::phase6
    end

    A --> B1
    A --> B2
    B1 --> D1
    B2 --> D2
    D1 --> C1
    D2 --> C1
    C1 --> C2 --> C3 --> C4
    C4 --> E1
    E1 --> E2 --> E3
    E3 --> F1
    F1 --> F2
    F2 --> G1
    C3 --> G1
    G1 --> G2 --> G3

    linkStyle default stroke:#888,stroke-width:1.5px
